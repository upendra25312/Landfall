{
  "$comment": "Landfall estimation config — YOUR FIRM'S numbers. The agent's tools apply these rather than inventing rates. Copy this file, edit, and point the Function app at it with the ESTIMATION_CONFIG app setting, or leave it at the repo root. Anything you omit falls back to the defaults in src/api/cost/config.py.",

  "pricing": {
    "region": "swedencentral",
    "currency": "USD",
    "reserved_term": "1yr",
    "reservation_coverage_pct": 80,
    "azure_hybrid_benefit_windows": true,
    "azure_hybrid_benefit_sql": true,
    "dev_test_pricing_nonprod": false
  },

  "rightsize": {
    "utilisation_metric": "p95",
    "cpu_target_utilisation_pct": 65,
    "ram_target_utilisation_pct": 80,
    "min_vcpu_retain_pct": 50,
    "min_ram_retain_pct": 60,
    "vcpu_floor": 2,
    "ram_floor_gb": 4,
    "headroom_band_pct": 20,
    "no_perf_data": {
      "cpu_scale_pct": 100,
      "ram_scale_pct": 100,
      "confidence": "low"
    }
  },

  "uplift": {
    "nonprod_of_prod_pct": 100,
    "dr_of_prod_pct": 100,
    "dev_test_discount_pct": 55
  },

  "storage": {
    "$comment": "estimate_storage_cost — file shares, DB volumes, object storage. Block volumes are priced by estimate_compute_cost; set price_block_from_storage_table true only if you also disable disk pricing there. Rates are refreshed from prices.azure.com at call time; the values below are the fallback / your negotiated rates.",
    "price_block_from_storage_table": false,
    "db_growth_headroom_pct": 20,
    "rate_band_pct": 25,
    "min_provision_gb": {
      "files_premium": 100,
      "anf_standard": 4096,
      "anf_premium": 4096,
      "anf_ultra": 4096
    },
    "rates_usd_gb_month": {
      "files_premium": 0.1636,
      "files_standard_hot": 0.06,
      "anf_standard": 0.1466,
      "anf_premium": 0.2932,
      "anf_ultra": 0.3908,
      "db_sql_mi": 0.115,
      "db_sql_hyperscale": 0.10,
      "db_flex_postgresql": 0.115,
      "db_flex_mysql": 0.115,
      "db_oracle": 0.161,
      "blob_hot_lrs": 0.0196,
      "blob_cool_lrs": 0.0115,
      "managed_premium_ssd_v2": 0.075
    }
  },

  "extras": {
    "$comment": "estimate_run_rate_extras — backup / egress / monitoring / support run-rate + one-time migration cost. Slow-moving list rates; pin your negotiated numbers.",
    "backup": {
      "enabled": true,
      "backup_size_factor": 1.3,
      "vault_storage_usd_gb_month": 0.0224,
      "protected_instance_usd_month": 5.0
    },
    "egress": {
      "free_gb_month": 100,
      "usd_per_gb": 0.05,
      "internet_fraction_of_net_out": 0.30
    },
    "monitoring": {
      "log_analytics_gb_per_server_day": 0.5,
      "log_analytics_usd_gb": 2.30,
      "defender_for_servers": true,
      "defender_usd_server_month": 15.0
    },
    "support": {
      "plan": "standard",
      "flat_usd_month": { "developer": 29, "standard": 100, "prodirect": 1000 }
    },
    "one_time": {
      "migration_tooling_free_days": 180,
      "migration_tooling_usd_server_month": 25.0,
      "avg_migration_months_per_server": 3,
      "replication_egress_usd_per_gb": 0.0,
      "dual_run_overlap_months": 1.5,
      "dual_run_fraction_of_infra": 0.5
    }
  },

  "disposition": {
    "$comment": "score_dispositions — rule-derived 6R. appetite: rehost_first | replatform_where_easy | aggressive. Replatform fires only for criticality >= replatform_min_criticality, <= replatform_max_servers, no clustering markers.",
    "appetite": "rehost_first",
    "replatform_min_criticality": 3,
    "replatform_max_servers": 6,
    "allow_refactor": false,
    "clustered_markers": ["always on", "always-on", "availability group", "data guard", "rac", "patroni", "galera", "wsfc", "replica set"],
    "container_markers": ["docker", "kubernetes", "k8s", "containerd", "openshift"],
    "retire_markers": ["sandbox", "proof of concept", "poc", "decommission", "to be retired", "print & output", "legacy billing (frozen)"],
    "repurchase_markers": { "learning management": "SaaS LMS", "collaboration": "SharePoint Online / Teams" }
  },

  "waves": {
    "$comment": "plan_waves — dependency graph -> affinity move-groups -> risk-ordered waves. Commodity protocols/ports (AD, DNS, NTP) and shared-infra apps don't form affinity groups; they migrate in the platform wave.",
    "min_edge_confidence": "low",
    "stale_after_days": 21,
    "observation_window_end": null,
    "max_servers_per_wave": 40,
    "max_apps_per_wave": 6,
    "commodity_protocols": ["LDAP", "LDAPS", "DNS", "NTP", "KERBEROS", "SMB", "CIFS", "SNMP"],
    "commodity_ports": [53, 88, 123, 137, 138, 139, 389, 445, 636, 3268, 3269, 514, 161],
    "infra_app_markers": ["infrastructure", "shared services", "shared-infra", "platform services", "active directory", "domain services"],
    "regulated_scopes_last": ["PCI-DSS", "PCI", "HIPAA", "HITRUST"]
  },

  "effort": {
    "bands_pd": { "S": 8, "M": 14, "L": 22, "XL": 40 },
    "assessment_pd_per_server": 0.15,
    "assessment_pd_per_app": 1.5,
    "rehost_pd_per_server": 0.5,
    "pm_pct": 15,
    "governance_pct": 10,
    "contingency_pct": null
  },

  "rates": {
    "blended_day_rate": 780,
    "currency": "USD"
  },

  "landing_zone": {
    "$comment": "design_landing_zone — the engagement's platform choices. The ALZ topology (spokes, subscriptions, regulated spoke) is DERIVED from the application portfolio; these are the inputs that derivation needs.",
    "org_id": "mrg",
    "primary_region": "swedencentral",
    "dr_region": "westeurope",
    "ip_supernet": "10.100.0.0/14",
    "dr_ip_supernet": "10.104.0.0/14",
    "hub_prefix": 22,
    "spoke_prefix": 22,
    "connectivity": "expressroute+vpn",
    "identity_model": "extend_ad",
    "forced_tunnel_egress": true,
    "prod_availability_zones": true,
    "environments": ["prod", "nonprod"],
    "regulated_scopes": ["PCI-DSS", "PCI", "HIPAA", "HITRUST", "IRAP", "FedRAMP", "CJIS", "ITAR"],
    "policy_baseline": [
      "Azure Landing Zones default",
      "Microsoft Cloud Security Benchmark",
      "CIS Azure Foundations Benchmark v2.0"
    ],
    "resiliency_tiers": {
      "1": { "rpo": "15 min", "rto": "2 h", "pattern": "zone-redundant + cross-region replication (ASR / native DB)" },
      "2": { "rpo": "1 h", "rto": "8 h", "pattern": "zone-redundant + cross-region ASR" },
      "3": { "rpo": "24 h", "rto": "48 h", "pattern": "zonal + Azure Backup restore" },
      "4": { "rpo": "24 h", "rto": "5 d", "pattern": "Azure Backup restore only" }
    }
  }
}
