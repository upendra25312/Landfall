    {"id": "SC7", "name": "No Azure Hybrid Benefit",
     "servers": "all", "overrides": {"pricing": {"azure_hybrid_benefit_windows": false}},
     "expect": {"run_rate_monthly": [121900, 143100], "one_time_cost": [80200, 94300]}},
    {"id": "SC8", "name": "Small 10-server slice",
     "servers": "first=10", "expect": {
