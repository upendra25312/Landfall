{
  "openapi": "3.0.1",
  "info": {
    "title": "assemble_estimate",
    "description": "Assembles the outputs of the other Landfall tools (estimate_compute_cost, estimate_storage_cost, estimate_run_rate_extras, design_landing_zone, score_dispositions, plan_waves) plus an inventory summary into ONE structured estimate package: eight sections, a stable ID + calculation-appendix entry on every headline figure (source tool, inputs, formula, assumptions applied, confidence), a machine-built assumptions / exclusions / data-gaps register collected from every tool's own caveats, a parametric migration-effort and services-cost estimate, and a markdown render. Deterministic. Call this last, after the other tools.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://REPLACE/api"
    }
  ],
  "paths": {
    "/assemble_estimate": {
      "post": {
        "operationId": "assemble_estimate",
        "summary": "One structured estimate package with a calculation appendix",
        "description": "Pass an inventory_summary (servers, applications, total_vcpu/ram, disk TB, os_mix, by_env, criticality_spread, eol_servers) and the JSON returned by each tool you ran: compute_cost, storage_cost, run_rate_extras, landing_zone, dispositions, waves. Also pass data_quality {confidence, findings} from the ingestion report and generated_on (today). Returns meta, sections[], figures[], calculation_appendix[], register{assumptions,exclusions,data_gaps}, and summary_markdown. Present summary_markdown and the headline figures; every number is traceable via its figure id.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "inventory_summary"
                ],
                "properties": {
                  "inventory_summary": {
                    "type": "object",
                    "properties": {
                      "servers": {
                        "type": "number"
                      },
                      "servers_powered_on": {
                        "type": "number"
                      },
                      "applications": {
                        "type": "number"
                      },
                      "total_vcpu": {
                        "type": "number"
                      },
                      "total_ram_gb": {
                        "type": "number"
                      },
                      "provisioned_disk_tb": {
                        "type": "number"
                      },
                      "used_disk_tb": {
                        "type": "number"
                      },
                      "os_mix": {
                        "type": "object"
                      },
                      "by_env": {
                        "type": "object"
                      },
                      "criticality_spread": {
                        "type": "object"
                      },
                      "eol_servers": {
                        "type": "number"
                      },
                      "no_perf_data_servers": {
                        "type": "number"
                      }
                    }
                  },
                  "data_quality": {
                    "type": "object",
                    "properties": {
                      "confidence": {
                        "type": "string"
                      },
                      "findings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "compute_cost": {
                    "type": "object",
                    "nullable": true
                  },
                  "storage_cost": {
                    "type": "object",
                    "nullable": true
                  },
                  "run_rate_extras": {
                    "type": "object",
                    "nullable": true
                  },
                  "landing_zone": {
                    "type": "object",
                    "nullable": true
                  },
                  "dispositions": {
                    "type": "object",
                    "nullable": true
                  },
                  "waves": {
                    "type": "object",
                    "nullable": true
                  },
                  "generated_on": {
                    "type": "string",
                    "nullable": true
                  },
                  "config": {
                    "type": "object",
                    "nullable": true
                  },
                  "engagement": {
                    "type": "string",
                    "description": "Engagement id as '<customer>/<project>' (lowercase, [a-z0-9-] per segment). Scopes the data and where the deliverables are written. Omit only for the legacy single-estate flow (defaults to '_default_/_default_')."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The assembled estimate package",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "type": "object"
                    },
                    "sections": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "figures": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "calculation_appendix": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "register": {
                      "type": "object"
                    },
                    "summary_markdown": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
